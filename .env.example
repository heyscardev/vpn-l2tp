# ====== Datos de la VPN L2TP (sin IPsec) ======
VPN_SERVER=vpn.ejemplo.com        # IP o dominio del servidor L2TP
VPN_USER=mi_usuario
VPN_PASS=mi_contraseña

# ====== Destino SSH al que vas a conectarte (a través de la VPN) ======
SSH_HOST=10.0.0.5                 # típicamente una IP interna de la red VPN
SSH_PORT=22
SSH_USER=mi_usuario_ssh
# Deja vacío si usas llave SSH montada en /root/.ssh
SSH_PASS=

# 1 = al entrar al contenedor como root (docker exec ... bash) salta directo al SSH
AUTO_SSH=1

# ====== Base de datos ======
# La BD queda accesible en el gestor web http://localhost:8978 (CloudBeaver)
# y también en 127.0.0.1:DB_LOCAL_PORT del Mac (DBeaver, TablePlus, etc.).
DB_HOST=10.0.0.20
DB_PORT=5432
DB_LOCAL_PORT=15432
# 0 = la BD es alcanzable directo desde la VPN
# 1 = la BD solo es alcanzable desde SSH_HOST (túnel SSH; usa DB_HOST=localhost si está en el mismo servidor)
DB_VIA_SSH=0
# postgres | mysql | mariadb | sqlserver | oracle
DB_TYPE=postgres
DB_NAME=mi_base
DB_USER=usuario_bd
DB_PASS=
# 1 = la conexión en CloudBeaver es de solo lectura
DB_READ_ONLY=1
DB_CONNECTION_NAME=Producción

# ====== Login de CloudBeaver (http://localhost:8978) ======
# Contraseña: mínimo 8 caracteres, mayúsculas y minúsculas, al menos 1 número.
CB_ADMIN_NAME=qa
CB_ADMIN_PASSWORD=
