# ====== Datos de la VPN L2TP (sin IPsec) ======
VPN_SERVER=vpn.ejemplo.com        # IP o dominio del servidor L2TP
VPN_USER=mi_usuario
VPN_PASS=mi_contraseña

# ====== Destino SSH al que vas a conectarte (a través de la VPN) ======
SSH_HOST=10.0.0.5                 # típicamente una IP interna de la red VPN
SSH_PORT=22
SSH_USER=mi_usuario_ssh
# Deja vacío si usas llave SSH montada en /root/.ssh
SSH_PASS=
